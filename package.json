{
  "name": "open-ppt-speaker",
  "version": "1.0.2",
  "description": "OpenPPTSpeaker（开源 PPT 讲演助手）：千问驱动的讲解引擎 + 语音会话 + 可打断问答",
  "main": "./out/main/index.js",
  "author": "zjjqy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjjqy/OpenPPTSpeaker.git"
  },
  "scripts": {
    "dev": "electron-vite build && chcp 65001 >nul && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "package:win": "electron-vite build && electron-builder --win",
    "publish:gitee": "node scripts/publish-release-gitee.mjs"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "ffmpeg-static": "^5.2.0",
    "mpg123-decoder": "^1.0.3",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.2.0",
    "pinyin-pro": "^3.29.3",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "vue": "^3.5.13",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "playwright": "^1.62.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.1.0"
  }
}
